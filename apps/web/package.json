  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260829.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "6.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.10",
    "wrangler": "4.127.1"
  }
}
