{
  "name": "@prooflens/cli",
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "prooflens": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -b ../claim/tsconfig.json ../identity/tsconfig.json ../metadata/tsconfig.json ../c2pa-node/tsconfig.json ../verifier/tsconfig.json ../../fixtures/tsconfig.json && vitest run"
  },
  "dependencies": {
    "@prooflens/c2pa-node": "workspace:*",
    "@prooflens/claim": "workspace:*",
    "@prooflens/identity": "workspace:*",
    "@prooflens/metadata": "workspace:*",
    "@prooflens/verifier": "workspace:*"
  },
  "devDependencies": {
    "@prooflens/fixtures": "workspace:*",
    "@types/node": "26.1.2",
    "typescript": "6.0.2",
    "vitest": "4.1.10"
  }
}
