{
  "name": "prooflens",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "corepack pnpm -r --if-present build",
    "typecheck": "tsc -b --pretty false && corepack pnpm -r --if-present typecheck:tests",
    "test": "corepack pnpm -r --if-present test",
    "test:python": "node scripts/run-python-tests.mjs",
    "test:browser": "corepack pnpm --filter @prooflens/react test:browser",
    "check": "corepack pnpm typecheck && corepack pnpm test && corepack pnpm test:python && corepack pnpm build && corepack pnpm test:browser"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "playwright": "1.62.1",
    "typescript": "6.0.2",
    "vitest": "4.1.10"
  }
}
